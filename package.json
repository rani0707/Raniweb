{
  "name": "rani-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/standalone.mjs prepare",
    "start": "node scripts/standalone.mjs start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "smoke": "node tests/integration/production.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=26.13.1 <27",
    "npm": ">=11"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "sharp": "0.35.5",
    "typescript": "npm:@typescript/typescript6@^6.0.3"
  },
  "type": "module",
  "overrides": {
    "eslint-config-next@16.4.6": {
      "eslint-plugin-import@2.32.0": { "eslint": "$eslint" },
      "eslint-plugin-jsx-a11y@6.10.2": { "eslint": "$eslint" },
      "eslint-plugin-react@7.37.5": { "eslint": "$eslint" }
    },
    "minimatch@>=7 <11.0.1": "11.0.7"
  }
}
