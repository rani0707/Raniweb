# Only send the files used to install and build the application.
**
!package.json
!package-lock.json
!tsconfig.json
!next.config.js
!proxy.ts
!app/
!app/**
!components/
!components/**
!data/
!data/**
!lib/
!lib/**
!public/
!public/**
!scripts/
!scripts/standalone.mjs

# Keep credentials and local artifacts out even under included directories.
**/.env*
**/.npmrc
**/.DS_Store
**/*.log
**/*.pem
**/*.key
**/*.textClipping
